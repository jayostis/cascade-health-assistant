{
  "name": "cascade-health-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "A health assistant on a Cascade pod: a chat with a model over a person's records.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayostis/cascade-health-assistant.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "help": "node help.ts",
    "start": "node server/main.ts",
    "dev": "node server/main.ts --dev",
    "browser": "node server/browser.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reset": "node pod.ts everything",
    "pod:load": "node pod.ts load",
    "pod:new": "node pod.ts new",
    "pod:reset": "node pod.ts reset",
    "kit:export": "node kit.ts",
    "patient:add": "node patient.ts",
    "ask": "node ask.ts",
    "console": "node console.ts",
    "model": "node model.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.73",
    "@ai-sdk/groq": "4.0.56",
    "@ai-sdk/openai-compatible": "3.0.64",
    "@ai-sdk/react": "4.0.132",
    "@assistant-ui/react": "0.15.25",
    "@assistant-ui/react-ai-sdk": "1.4.16",
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@the-cascade-protocol/sandbox": "file:demo-hospital",
    "ai": "7.0.129",
    "cascade-runtime": "https://github.com/jayostis/cascade-runtime-js/releases/download/build-95e98c82525e50cc3bc081d9d7dafe324f3c3dff/cascade-runtime-0.0.0-commit-95e98c82525e50cc3bc081d9d7dafe324f3c3dff.tgz",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.23",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.1.0"
  }
}
